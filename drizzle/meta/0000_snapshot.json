          "value": "\"reviews\".\"revision\" >= 1"
        },
        "reviews_title_check": {
          "name": "reviews_title_check",
          "value": "length(\"reviews\".\"title\") between 5 and 100"
        },
        "reviews_text_check": {
          "name": "reviews_text_check",
          "value": "length(\"reviews\".\"review_text\") between 50 and 2000"
        },
        "reviews_scores_check": {
          "name": "reviews_scores_check",
          "value": "\n    (\"reviews\".\"technology\" is null or \"reviews\".\"technology\" between 1 and 5) and\n    (\"reviews\".\"learning\" is null or \"reviews\".\"learning\" between 1 and 5) and\n    (\"reviews\".\"clubs\" is null or \"reviews\".\"clubs\" between 1 and 5) and\n    (\"reviews\".\"teachers\" is null or \"reviews\".\"teachers\" between 1 and 5) and\n    (\"reviews\".\"administration\" is null or \"reviews\".\"administration\" between 1 and 5) and\n    (\"reviews\".\"safety\" is null or \"reviews\".\"safety\" between 1 and 5) and\n    (\"reviews\".\"culture\" is null or \"reviews\".\"culture\" between 1 and 5)"
        },
        "reviews_at_least_one_score": {
          "name": "reviews_at_least_one_score",
          "value": "coalesce(\"reviews\".\"technology\", \"reviews\".\"learning\", \"reviews\".\"clubs\", \"reviews\".\"teachers\", \"reviews\".\"administration\", \"reviews\".\"safety\", \"reviews\".\"culture\") is not null"
        }
